---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page does not exist." noindex>
  <section class="relative overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative py-28 md:py-40">
      <p class="font-mono text-sm text-ti-2">dyld: Library not loaded: <span class="text-amber">this page</span></p>
      <p class="font-mono text-sm text-ti-3">Reason: image not found · status 404</p>
      <h1 class="display mt-10 text-[clamp(2.8rem,8vw,6rem)]">Nothing mapped here.</h1>
      <p class="lede mt-6 max-w-xl">The page you asked for does not exist. A precise failure is still a result.</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">Back to MacBridge</a>
        <a href="/research" class="btn btn-ghost">Research</a>
      </div>
    </div>
  </section>
</Base>
