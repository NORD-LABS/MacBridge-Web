---
import Base from '../layouts/Base.astro';
import Bridge from '../components/Bridge.astro';
import Status from '../components/Status.astro';
import { REPO, doc } from '../config';

const capabilities = [
  { kind: 'PASS', what: 'Inspector app: reads macOS apps (Mach-O, bundles, signatures, entitlements, dependencies) without running them', where: 'Physical iPad Air (M3) · Mac' },
  { kind: 'PASS', what: "MacBridge's own macOS-built ARM64 test library run by MacBridge's loader; Apple's loader refuses the same file", where: 'Physical iPad · development signing' },
  { kind: 'PASS', what: "Objective-C classes of an own macOS-built test library registered; their methods ran", where: 'Physical iPad · run twice' },
  { kind: 'PARTIAL', what: 'Load surface for the 47 definitions Blender needs just to load (39 from AppKit)', where: 'Intel Mac · x86_64 simulator' },
  { kind: 'UNKNOWN', what: 'Code signed by another developer, or a distribution (App Store / TestFlight) build', where: 'Untested' },
  { kind: 'NOT DEMONSTRATED', what: 'A standalone macOS program, AppKit code, or any macOS application on an iPad', where: 'Any device' },
  { kind: 'NOT DEMONSTRATED', what: 'Blender running through MacBridge, at any stage', where: 'Any device' },
] as const;

const method = [
  { n: '01', t: 'Inspect', d: 'Read a macOS app without running it: Mach-O load commands, code signatures, entitlements, nested helpers, the full dependency graph.' },
  { n: '02', t: 'Map', d: 'Route every library link and imported symbol to an iPadOS library, a MacBridge stand-in, or a named conflict. 1,453 symbols for a headless Blender start.' },
  { n: '03', t: 'Build original fixtures', d: 'Small C, C++ and Objective-C test libraries written for MacBridge, each built so that one result depends on one loader step.' },
  { n: '04', t: 'Measure, per environment', d: 'Run on Cloud Linux, an Intel Mac, the simulator and a physical iPad. Results are never copied from one environment to another.' },
];

const roadmap = [
  { p: '0–1', t: 'Foundations · Inspection', k: 'COMPLETE' },
  { p: '2', t: 'Static compatibility mapping', k: 'ACTIVE' },
  { p: '3–4', t: 'Compatibility components · Host execution', k: 'EXPERIMENTAL' },
  { p: '5', t: 'Physical-iPad feasibility', k: 'ACTIVE' },
  { p: '6', t: 'First macOS program on an iPad', k: 'ACTIVE' },
  { p: '7–11', t: 'Headless runtime → Blender → Windows → Metal', k: 'NOT STARTED' },
] as const;
---

<Base>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b hairline">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-[-12rem] h-[34rem] w-[60rem] -translate-x-1/2 rounded-full bg-ice/[0.05] blur-3xl"></div>
    <div class="wrap relative pt-20 pb-20 md:pt-32 md:pb-28">
      <div class="flex flex-wrap items-center gap-3">
        <span class="eyebrow">NORD LABS · Systems research</span>
        <a href="/first-contact" class="group inline-flex items-center gap-2 rounded-full border border-ice/30 bg-ice/[0.06] px-3 py-1 font-mono text-[0.68rem] tracking-[0.08em] text-ice hover:border-ice/60">
          <i class="h-1.5 w-1.5 rounded-full bg-ice" aria-hidden="true"></i>
          FIRST CONTACT · 2026-10-10
          <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
        </a>
      </div>
      <h1 class="display mt-8 text-[clamp(3rem,9.5vw,7.6rem)]">
        Mac software.<br />
        <span class="text-ti">iPad hardware.</span>
      </h1>
      <p class="mt-8 font-display text-[clamp(1.25rem,2.4vw,1.75rem)] font-medium tracking-[-0.015em] text-paper/90">Exploring the space between.</p>
      <p class="lede mt-5 max-w-2xl">
        MacBridge is independent research into whether unmodified ARM64 macOS apps could one day run
        locally on an Apple Silicon iPad, through an original compatibility layer. Not streaming, not
        a virtual machine, not a port, not a jailbreak.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/research" class="btn btn-primary">Read the research <span aria-hidden="true">→</span></a>
        <a href={REPO} class="btn btn-ghost" rel="noopener">View on GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <!-- BRIDGE -->
  <section class="border-b hairline">
    <div class="wrap py-20 md:py-28">
      <div class="reveal grid gap-6 md:grid-cols-[1fr_1.2fr] md:items-end">
        <div>
          <p class="eyebrow">The gap</p>
          <h2 class="h2 mt-4">Same processor.<br />Different operating system.</h2>
        </div>
        <p class="lede md:pb-1">
          An iPad and a Mac share the same family of Apple Silicon chips, so there is no instruction
          translation in the way. What separates them is software: the loader, system libraries,
          Objective-C, windows, input and graphics. MacBridge examines those layers one at a time.
        </p>
      </div>
      <div class="reveal mt-14 card p-6 md:p-10">
        <Bridge />
      </div>
    </div>
  </section>

  <!-- FIRST CONTACT -->
  <section class="border-b hairline">
    <div class="wrap py-20 md:py-28">
      <div class="reveal grid gap-12 lg:grid-cols-[1.05fr_1fr]">
        <div>
          <p class="eyebrow">Research milestone · 2026-10-10</p>
          <h2 class="h2 mt-4">First Contact</h2>
          <p class="lede mt-6">
            On a physical iPad Air (M3) running iPadOS 27.0, MacBridge's experimental loader ran{' '}
            <strong class="text-paper font-medium">its own small ARM64 test library, built for macOS</strong>. It registered the
            library's code signature with the system, mapped it, connected every pointer and import with
            zero differences from its model, ran its start-up code and called its functions.
          </p>
          <p class="mt-5 text-ti leading-relaxed">
            Apple's own loader refuses the same file as an incompatible platform. Later the same day,
            Objective-C classes from an own macOS-built test library were registered and their methods ran.
          </p>
          <a href="/first-contact" class="arrow-link mt-8 text-[0.95rem]">What was shown, and what was not <span aria-hidden="true">→</span></a>
        </div>
        <div class="card overflow-hidden">
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b hairline px-5 py-3">
            <span class="font-mono text-[0.68rem] tracking-[0.1em] text-ti-2">DEVICEPROBE · iPad Air (M3) · iPadOS 27.0</span>
            <span class="font-mono text-[0.68rem] text-ti-3">run 2 of 2</span>
          </div>
          <dl class="divide-y divide-white/[0.06] font-mono text-[0.8rem]">
            <div class="flex justify-between gap-4 px-5 py-3"><dt class="text-ti-2">Apple loader · macOS build</dt><dd class="text-amber">refused</dd></div>
            <div class="flex justify-between gap-4 px-5 py-3"><dt class="text-ti-2">signature registered</dt><dd class="text-paper">accepted</dd></div>
            <div class="flex justify-between gap-4 px-5 py-3"><dt class="text-ti-2">memory vs. model</dt><dd class="text-paper">0 bytes differ</dd></div>
            <div class="flex justify-between gap-4 px-5 py-3"><dt class="text-ti-2">initializer</dt><dd class="text-paper">ran</dd></div>
            <div class="flex justify-between gap-4 px-5 py-3"><dt class="text-ti-2">expected</dt><dd class="text-ti">42 · 30 · 6 · 8 · 1</dd></div>
            <div class="flex justify-between gap-4 px-5 py-3"><dt class="text-ti-2">returned</dt><dd class="text-ice">42 · 30 · 6 · 8 · 1</dd></div>
          </dl>
          <p class="border-t hairline px-5 py-4 text-[0.8rem] leading-relaxed text-ti-2">
            Own NORD LABS test code · same developer team as the app · development build. No standalone
            program, no AppKit, no Blender.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section class="border-b hairline">
    <div class="wrap py-20 md:py-28">
      <div class="reveal flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow">Where things stand</p>
          <h2 class="h2 mt-4">Experimental capability status</h2>
        </div>
        <p class="max-w-md text-sm text-ti-2">Every result names the environment it was measured in. A Mac result is not an iPad result. A test library is not an application.</p>
      </div>
      <ul class="reveal mt-12 divide-y divide-white/[0.07] border-y hairline">
        {capabilities.map((c) => (
          <li class="grid gap-3 py-5 md:grid-cols-[11rem_1fr_15rem] md:items-center md:gap-8">
            <div><Status kind={c.kind} /></div>
            <p class="text-paper/90 leading-relaxed">{c.what}</p>
            <p class="font-mono text-[0.72rem] tracking-[0.04em] text-ti-2 md:text-right">{c.where}</p>
          </li>
        ))}
      </ul>
      <a href={doc('STATUS.md')} class="arrow-link mt-8 text-[0.95rem]">Full status, by environment <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <!-- METHOD -->
  <section class="border-b hairline">
    <div class="wrap py-20 md:py-28">
      <div class="reveal max-w-2xl">
        <p class="eyebrow">Method</p>
        <h2 class="h2 mt-4">Proof over promises.</h2>
        <p class="lede mt-5">Each result carries a status, an environment, and how it was established: measured, known from documentation, or inferred. A precise failure is a result worth publishing.</p>
      </div>
      <ol class="reveal mt-14 grid gap-px overflow-hidden rounded-2xl border hairline bg-white/[0.07] sm:grid-cols-2 lg:grid-cols-4">
        {method.map((m) => (
          <li class="bg-ink p-7">
            <span class="font-mono text-xs text-ice">{m.n}</span>
            <h3 class="mt-6 font-display text-lg font-semibold tracking-[-0.01em]">{m.t}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ti">{m.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ROADMAP PREVIEW -->
  <section class="border-b hairline">
    <div class="wrap py-20 md:py-28">
      <div class="reveal grid gap-12 lg:grid-cols-[1fr_1.4fr]">
        <div>
          <p class="eyebrow">Roadmap</p>
          <h2 class="h2 mt-4">North Star: Blender.</h2>
          <p class="lede mt-5">
            The long-term target is the official, unmodified ARM64 macOS build of Blender, running locally on
            an iPad. It is a direction for the research, not a feature. No dates, no percentages: a phase
            ends when its result is recorded, positive or negative.
          </p>
          <a href="/roadmap" class="arrow-link mt-8 text-[0.95rem]">The full roadmap <span aria-hidden="true">→</span></a>
        </div>
        <ol class="relative">
          {roadmap.map((r, i) => (
            <li class="relative flex items-center gap-5 border-b hairline py-4 first:pt-0 last:border-0">
              <span class="w-12 shrink-0 font-mono text-xs text-ti-2">{r.p}</span>
              <span class={`flex-1 ${r.k === 'NOT STARTED' ? 'text-ti-2' : 'text-paper'}`}>{r.t}</span>
              <Status kind={r.k} />
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- LINKS -->
  <section>
    <div class="wrap py-20 md:py-28">
      <div class="reveal grid gap-4 md:grid-cols-3">
        <a href={REPO} rel="noopener" class="card group p-7 transition-colors hover:border-white/20">
          <p class="eyebrow">GitHub</p>
          <p class="mt-6 font-display text-xl font-semibold">MacBridge-Project</p>
          <p class="mt-2 text-sm text-ti">Public project page, status, roadmap and research journal.</p>
          <span class="arrow-link mt-6 text-sm">github.com/NORD-LABS <span aria-hidden="true">↗</span></span>
        </a>
        <a href="/docs" class="card group p-7 transition-colors hover:border-white/20">
          <p class="eyebrow">Documentation</p>
          <p class="mt-6 font-display text-xl font-semibold">Research documentation</p>
          <p class="mt-2 text-sm text-ti">Introduction, concepts, architecture, the loader, Objective-C, evidence.</p>
          <span class="arrow-link mt-6 text-sm">Browse the index <span aria-hidden="true">→</span></span>
        </a>
        <a href={doc('docs/evidence.md')} class="card group p-7 transition-colors hover:border-white/20">
          <p class="eyebrow">Evidence</p>
          <p class="mt-6 font-display text-xl font-semibold">How results are established</p>
          <p class="mt-2 text-sm text-ti">Status labels, environments, rules, and every correction made so far.</p>
          <span class="arrow-link mt-6 text-sm">Read the method <span aria-hidden="true">↗</span></span>
        </a>
      </div>
      <p class="reveal mt-16 text-center font-display text-[clamp(1.1rem,2vw,1.4rem)] leading-snug text-ti">
        The hardware is already in people's hands.<br class="hidden sm:block" />
        MacBridge is an attempt to find out how much more it can do,<br class="hidden sm:block" />
        and to write down honestly what stands in the way.
      </p>
    </div>
  </section>
</Base>
