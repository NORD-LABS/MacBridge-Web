---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { doc, DOCS_PR, REPO } from '../config';

const groups = [
  {
    title: 'Start here',
    items: [
      ['Introduction', 'The idea in five minutes.', 'docs/introduction.md'],
      ['How it works, in plain language', 'No technical background needed.', 'docs/how-it-works.md'],
      ['Status', 'What works today, and in which environment.', 'STATUS.md'],
      ['Roadmap', 'What comes next and what could stop it.', 'ROADMAP.md'],
      ['FAQ', 'Quick answers.', 'docs/faq.md'],
    ],
  },
  {
    title: 'Go deeper',
    items: [
      ['Technical concepts', 'Mach-O, loading, fixups, signing: the Apple concepts MacBridge deals with.', 'docs/concepts.md'],
      ['Architecture', 'How the pieces fit together, and what exists of each.', 'docs/architecture.md'],
      ['The experimental loader', 'What a loader does and what MacBridge’s has demonstrated.', 'docs/research/loader.md'],
      ['Objective-C research', 'Why classes matter during loading; the NSColor question.', 'docs/research/objective-c.md'],
      ['DeviceProbe', 'The first experiment designed for a physical iPad.', 'docs/research/device-probe.md'],
      ['First Contact', 'What ran on the iPad on 2026-10-10, and what it does not show.', 'docs/research/first-contact.md'],
      ['Blender research', 'Why Blender, how it is studied, and what was found.', 'docs/research/blender.md'],
    ],
  },
  {
    title: 'How claims are checked',
    items: [
      ['How results are established', 'Status labels, environments, rules, test baselines and corrections.', 'docs/evidence.md'],
      ['Verified facts', 'The exact public wording of each verified fact, and its source.', 'docs/facts.md'],
      ['Research journal', 'What changed, and when.', 'docs/journal.md'],
      ['Glossary', 'Terms used across these pages.', 'docs/glossary.md'],
    ],
  },
  {
    title: 'Take part',
    items: [
      ['Contributing', 'Errors, questions and reproducible observations.', 'CONTRIBUTING.md'],
      ['Security', 'Report privately; do not open a public issue.', 'SECURITY.md'],
      ['License', 'Proprietary, source-available. Not open source.', 'LICENSE.md'],
    ],
  },
];
---

<Base title="Documentation" description="Index of the public MacBridge research documentation: introduction, concepts, architecture, the experimental loader, Objective-C, DeviceProbe, First Contact, evidence and the research journal.">
  <PageHero
    eyebrow="Documentation"
    title="The research, in the open."
    lede="The full documentation lives in the public MacBridge-Project repository on GitHub. Technical depth increases from the introduction to the research pages."
  >
    <p class="mt-8 max-w-2xl text-sm leading-relaxed text-ti-2">
      These links point to the documentation currently in review as an{' '}
      <a href={DOCS_PR} class="text-ti underline decoration-white/20 underline-offset-2 hover:text-paper">open pull request</a>{' '}
      on the <code class="k">docs/northstar-project-atlas</code> branch. The implementation itself lives in a private NORD LABS repository.
    </p>
  </PageHero>

  <div class="wrap py-16 md:py-20">
    {groups.map((g) => (
      <section class="reveal grid gap-6 border-b hairline py-12 first:pt-0 last:border-0 lg:grid-cols-[14rem_1fr] lg:gap-16">
        <h2 class="eyebrow pt-1">{g.title}</h2>
        <ul class="grid gap-px overflow-hidden rounded-2xl border hairline bg-white/[0.07] sm:grid-cols-2">
          {g.items.map(([t, d, p]) => (
            <li class="bg-ink">
              <a href={p === 'LICENSE.md' ? `${REPO}/blob/main/LICENSE.md` : doc(p)} class="group flex h-full flex-col p-6 transition-colors hover:bg-white/[0.025]">
                <span class="flex items-start justify-between gap-4">
                  <span class="font-medium text-paper">{t}</span>
                  <span class="text-ti-3 transition-colors group-hover:text-ice" aria-hidden="true">↗</span>
                </span>
                <span class="mt-2 text-sm leading-relaxed text-ti-2">{d}</span>
                <span class="mt-4 font-mono text-[0.68rem] text-ti-3">{p}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
