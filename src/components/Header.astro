---
import Logo from './Logo.astro';
import { NAV, REPO } from '../config';

const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 border-b hairline bg-ink/80 backdrop-blur-md supports-[backdrop-filter]:bg-ink/65">
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <a href="/" class="group flex items-center gap-2.5 text-paper" aria-label="MacBridge home">
      <Logo class="h-6 w-6 text-paper" />
      <span class="font-display text-[0.95rem] font-semibold tracking-[0.18em]">MACBRIDGE</span>
      <span class="hidden sm:inline font-mono text-[0.65rem] tracking-[0.14em] text-ti-2 border-l hairline pl-2.5 ml-0.5">NORD LABS</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-1 text-[0.9rem]">
        {NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={current === item.href ? 'page' : undefined}
              class="rounded-full px-3.5 py-2 text-ti transition-colors hover:text-paper aria-[current=page]:text-paper aria-[current=page]:bg-white/[0.06]"
            >{item.label}</a>
          </li>
        ))}
        <li class="ml-2">
          <a href={REPO} class="btn btn-ghost !h-9 !text-[0.85rem]" rel="noopener">
            GitHub
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 2.5h6v6M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.3" fill="none" /></svg>
          </a>
        </li>
      </ul>
    </nav>

    <button
      id="menu-btn"
      type="button"
      class="md:hidden -mr-2 flex h-10 w-10 items-center justify-center rounded-full text-paper hover:bg-white/5"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
        <path class="l1 origin-center transition-transform duration-200" d="M3 7h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        <path class="l2 origin-center transition-transform duration-200" d="M3 13h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Mobile" class="md:hidden hidden border-t hairline">
    <ul class="wrap py-3">
      {NAV.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={current === item.href ? 'page' : undefined}
            class="flex items-center justify-between border-b hairline py-4 text-lg text-ti aria-[current=page]:text-paper"
          >{item.label}<span aria-hidden="true" class="text-ti-3">→</span></a>
        </li>
      ))}
      <li>
        <a href={REPO} rel="noopener" class="flex items-center justify-between py-4 text-lg text-ti">GitHub<span aria-hidden="true" class="text-ti-3">↗</span></a>
      </li>
    </ul>
  </nav>
</header>

<style>
  #menu-btn path { transform-box: fill-box; transform-origin: center; }
  #menu-btn[aria-expanded='true'] .l1 { transform: translateY(3px) rotate(45deg); }
  #menu-btn[aria-expanded='true'] .l2 { transform: translateY(-3px) rotate(-45deg); }
</style>

<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  if (btn && nav) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      nav.classList.toggle('hidden', !open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
    matchMedia('(min-width: 768px)').addEventListener('change', (m) => m.matches && set(false));
  }
</script>
